+void GuiGamelistOptions::openAdvancedSettings()
+{
+	if (ThreadedScraper::isRunning())
+	{
+		mWindow->pushGui(new GuiMsgBox(mWindow, _("THIS FUNCTION IS DISABLED WHEN SCRAPING IS RUNNING")));
+		return;
+	}
+
+	FileData* file = getGamelist()->getCursor()->getSourceFileData();
+	if (!file || file->getType() == FOLDER)
+		return;
+
+	ScraperSearchParams p;
+	p.game = file;
+	p.system = file->getSystem();
+
+	std::vector<MetaDataDecl> advanced;
+	for (const auto& decl : file->getMetadata().getMDD())
+	{
+		if (decl.key == "emulator" || decl.key == "core" || decl.key == "governor")
+			advanced.push_back(decl);
+	}
+
+	std::string title = std::string(_("EMULATOR")) + " / " + _("CORE");
+	mWindow->pushGui(new GuiMetaDataEd(mWindow, &file->getMetadata(), advanced, p, Utils::FileSystem::getFileName(file->getPath()),
+		std::bind(&IGameListView::onFileChanged, ViewController::get()->getGameListView(file->getSystem()).get(), file, FILE_METADATA_CHANGED), nullptr, file, title));
+}
