#!/bin/sh
M=/sys/devices/platform/ff740000.usb2-phy/otg_mode
i=0
while [ ! -e "$M" ] && [ "$i" -lt 50 ]; do
    sleep 0.2
    i=$((i+1))
done
[ -e "$M" ] || exit 0

# Sink first, so a charger that was already connected at boot is detected.
echo peripheral > "$M"
sleep 4

if [ "$(cat /sys/class/power_supply/ac/online 2>/dev/null)" = "1" ]; then
    echo "pocketais-usb-role: charger present, keeping peripheral"
else
    echo otg > "$M"
    echo "pocketais-usb-role: no charger, otg/host"
fi
