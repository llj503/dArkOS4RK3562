#!/bin/sh
M=/sys/devices/platform/ff740000.usb2-phy/otg_mode
last_probe=0
while true; do
    online=$(cat /sys/class/power_supply/ac/online 2>/dev/null || echo 0)
    mode=$(cat "$M" 2>/dev/null)
    devs=$(ls /sys/bus/usb/devices 2>/dev/null | grep -cE '^[0-9]+-[0-9]+$')

    if [ "$online" = "1" ]; then
        [ "$mode" = peripheral ] || echo peripheral > "$M"
    elif [ "$mode" = peripheral ]; then
        sleep 3
        if [ "$(cat /sys/class/power_supply/ac/online 2>/dev/null || echo 0)" = "0" ]; then
            echo otg > "$M"
        fi
    elif [ "$mode" = otg ] || [ "$mode" = host ]; then
        if [ "$devs" -eq 0 ]; then
            now=$(date +%s)
            if [ $((now - last_probe)) -ge 8 ]; then
                last_probe=$now
                echo peripheral > "$M"
                sleep 4
                if [ "$(cat /sys/class/power_supply/ac/online 2>/dev/null || echo 0)" = "1" ]; then
                    : # charger present, stay in peripheral
                else
                    echo otg > "$M"
                fi
            fi
        fi
    fi
    sleep 2
done
