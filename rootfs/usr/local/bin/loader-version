#!/bin/bash
# ============================================================
# loader-version — 读某块 eMMC/SD 的 Rockchip idblock (DDR loader)
#   输出: "<版本> <频率>"
#     版本: v1.07 / v1.10 ...   (idblock 里 "ddr-vX.YY" 字符串)
#     频率: 920 / 1560 / ?      (与内置 920/1560 v1.10 blob 比对得出)
#   用法: loader-version [设备, 默认 /dev/mmcblk0]
# ============================================================
DEV="${1:-/dev/mmcblk0}"
BLOB_DIR=/opt/darkos/loader
IDB_SECTORS=1024                 # 读前 512KiB idblock 区

[[ -b "$DEV" ]] || { echo "unknown ?"; exit 0; }

TMP="$(mktemp /tmp/ldrver.XXXXXX)" || exit 0
trap 'rm -f "$TMP" /tmp/ldrref_*.bin' EXIT
dd if="$DEV" of="$TMP" bs=512 skip=64 count=$IDB_SECTORS status=none 2>/dev/null || { echo "unknown ?"; exit 0; }

# 只认 RKNS idblock, 否则等于没 loader
[[ "$(head -c4 "$TMP")" == "RKNS" ]] || { echo "unknown ?"; exit 0; }

VER="$(tr -d '\0' < "$TMP" | grep -ao 'ddr-v[0-9][0-9.]*' | head -n1 | sed 's/^ddr-//')"

FREQ="?"
for f in 920 1560; do
  xz -dc "$BLOB_DIR/rk3562-loader-$f-v1.10.bin.xz" > "/tmp/ldrref_$f.bin" 2>/dev/null || continue
  SZ=$(stat -c %s "/tmp/ldrref_$f.bin" 2>/dev/null || echo 0)
  if [ "$SZ" -gt 0 ] && cmp -s -n "$SZ" "/tmp/ldrref_$f.bin" "$TMP"; then
    FREQ="$f"
    break
  fi
done

echo "${VER:-unknown} $FREQ"