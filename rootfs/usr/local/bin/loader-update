#!/bin/bash
# ============================================================
# loader-update — 兼容旧入口: 把 920MHz v1.10 loader 写入 eMMC (先备份)
#   实际逻辑见 loader-write; 新菜单直接调用 loader-write.
# 用法: sudo loader-update
# ============================================================
exec /usr/local/bin/loader-write 920 emmc backup