#!/bin/bash
# Unified hotkey provider for the psvita tooling.
#
# console_detect (https://github.com/lcdyk0517/console-detect) reports the
# board's hotkey type with -t/--hotkey. All pad hotkeys in this port go through
# this wrapper so there is one place to change the mapping: whatever the tool
# answers is passed through as-is, and only when it answers nothing do we fall
# back to the override file hook.sh writes.
set -u
BIN=/usr/local/bin/console_detect
OVERRIDE=/roms/psvita/Vita3k/.hotkey-type

case "${1:-}" in
    -t|--hotkey) ;;
    *) exec "$BIN" "$@" ;;
esac

T=$(timeout 5 "$BIN" -t 2>/dev/null | tr -d '\r\n')
[ -n "$T" ] && { printf '%s\n' "$T"; exit 0; }
if [ -r "$OVERRIDE" ]; then
    tr -d '\r\n' < "$OVERRIDE"; echo
    exit 0
fi
echo happy5
