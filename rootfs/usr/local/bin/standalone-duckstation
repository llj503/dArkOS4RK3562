#!/bin/bash

. /usr/local/bin/buttonmon.sh

echo "VAR=duckstation-min" > /home/ark/.config/KILLIT
sudo systemctl restart killer_daemon.service

filename=$(basename "$3")
filename="${filename%.*}"

directory=$(dirname "$3" | cut -d "/" -f2)

if [ ! -d "/$directory/psx/savestates" ]; then
    mkdir -p "/$directory/psx/savestates"
fi

if [ -d "$HOME/.local/share/duckstation/savestates" ]; then
    rm -rf "$HOME/.local/share/duckstation/savestates"
fi

# settings.ini 放 roms 分区 (save states 已有单独软链)
mkdir -p "/$directory/psx/duckstation"
if [ -f "$HOME/.local/share/duckstation/settings.ini" ] && [ ! -L "$HOME/.local/share/duckstation/settings.ini" ]; then
    cp -f "$HOME/.local/share/duckstation/settings.ini" "/$directory/psx/duckstation/settings.ini"
    rm -f "$HOME/.local/share/duckstation/settings.ini"
fi
ln -sfn "/$directory/psx/duckstation/settings.ini" "$HOME/.local/share/duckstation/settings.ini"
if [ ! -f "$HOME/.local/share/duckstation/settings.ini" ]; then
    cp /opt/duckstation/settings.ini.template "$HOME/.local/share/duckstation/settings.ini"
fi

if [ -f "$HOME/.local/share/duckstation/settings.ini" ]; then
  if [[ $directory == "roms2" ]]; then
   sed -i --follow-symlinks '/\/roms\//s//\/roms2\//g' "$HOME/.local/share/duckstation/settings.ini"
  else
   sed -i --follow-symlinks '/\/roms2\//s//\/roms\//g' "$HOME/.local/share/duckstation/settings.ini"
  fi
fi

# 跟随 ES 语言 (DuckStation 按 locale 加载 duckstation-qt_<lang>.qm)
if [ -f /home/ark/.config/.cn ] || grep -q 'name="Language" value="zh-CN"' /home/ark/.emulationstation/es_settings.cfg 2>/dev/null; then
  export LANG=zh_CN.UTF-8 LC_ALL=zh_CN.UTF-8
else
  export LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8
fi

ln -sfv "/$directory/psx/savestates" "$HOME/.local/share/duckstation/savestates"
# DuckStation 自带 SDL3, 按键枚举与 SDL2 不同, 必须用专用 gamecontrollerdb
ln -sfn /opt/duckstation/gamecontrollerdb.txt "$HOME/.local/share/gamecontrollerdb.txt"
ln -sfn /opt/duckstation/gamecontrollerdb.txt "$HOME/.local/share/duckstation/gamecontrollerdb.txt"

DS_SETTINGS="$HOME/.local/share/duckstation/settings.ini"
DS_ROM="${3}"

# 屏幕旋转: 竖屏机型 (xf55h/rg52mini) 需要把画面转 90 度, 其余为 0
DS_ROTATION=""
if [ -x /usr/local/bin/console_detect ]; then
  case "$(/usr/local/bin/console_detect -o 2>/dev/null)" in
    90)  DS_ROTATION=Rotate90 ;;
    180) DS_ROTATION=Rotate180 ;;
    270) DS_ROTATION=Rotate270 ;;
    0)   DS_ROTATION=Normal ;;
  esac
fi
if [ -n "$DS_ROTATION" ]; then
  if grep -q '^Rotation = ' "$DS_SETTINGS"; then
    sed -i --follow-symlinks "s/^Rotation = .*/Rotation = $DS_ROTATION/" "$DS_SETTINGS"
  else
    sed -i --follow-symlinks "0,/^\[Display\]/s//[Display]\nRotation = $DS_ROTATION/" "$DS_SETTINGS"
  fi
fi

run_duckstation() {
  # 官方 mini AppImage: SDL3 + Vulkan KHR display
  sed -i --follow-symlinks 's/^Renderer = .*/Renderer = Vulkan/' "$DS_SETTINGS"

  # 跟随 ES 语言: DuckStation 的 UI 语言由 [Main] Language 控制
  local lang=zh-CN
  if [ ! -f /home/ark/.config/.cn ] && ! grep -q 'name="Language" value="zh-CN"' /home/ark/.emulationstation/es_settings.cfg 2>/dev/null; then
    lang=en
  fi
  if grep -q '^Language = ' "$DS_SETTINGS"; then
    sed -i --follow-symlinks "s/^Language = .*/Language = $lang/" "$DS_SETTINGS"
  else
    sed -i --follow-symlinks "0,/^\[Main\]/s//[Main]\nLanguage = $lang/" "$DS_SETTINGS"
  fi
  if [ "$lang" = "zh-CN" ]; then
    export LANG=zh_CN.UTF-8 LC_ALL=zh_CN.UTF-8
  fi

  # 私编中文 mini 版优先 (不发布, 仅本机); 缺失时回退官方 AppImage
  if [ -x /opt/duckstation-mini-zh-private/run.sh ]; then
    /opt/duckstation-mini-zh-private/run.sh -fullscreen "$DS_ROM" > /dev/null 2>&1
  else
    /opt/duckstation/duckstationsa-official -fullscreen -- "$DS_ROM" > /dev/null 2>&1
  fi
}

Test_Button_A
if [ "$?" -eq "10" ]; then
  printf "\033c" >> /dev/tty1
  printf "\033[1;33m" >> /dev/tty1
  if [ ! -d "/$directory/psx/duckstation_gamesettings" ]; then
      printf "\n Creating /$directory/psx/duckstation_gamesettings/${filename}.settings.ini" >> /dev/tty1
      mkdir -p "/$directory/psx/duckstation_gamesettings"
  else
      printf "\n /$directory/psx/duckstation_gamesettings/${filename}.settings.ini" >> /dev/tty1
      printf "\n already exist!" >> /dev/tty1
  fi
  sleep 3
  printf "\033c" >> /dev/tty1
  printf "\033[0m" >> /dev/tty1
  if [ ! -f "/$directory/psx/duckstation_gamesettings/${filename}.settings.ini" ]; then
      cp "$HOME/.local/share/duckstation/settings.ini" "/$directory/psx/duckstation_gamesettings/${filename}.settings.ini"
  fi
  run_duckstation
else
  if [ -f "/$directory/psx/duckstation_gamesettings/${filename}.settings.ini" ]; then
    run_duckstation
  else
    run_duckstation
  fi
fi

sudo systemctl stop killer_daemon.service
