#!/bin/bash
# fanctl -- pwm-fan 转速控制 (0-255)
#   fanctl set N   手动转速, N = 1-255
#   fanctl on      开启 (PWM 0)
#   fanctl off     关闭 (PWM 0, 兼容 .FAN_DISABLED 标记)
#   fanctl apply   开机应用 /home/ark/.config/fan.cfg
#   fanctl toggle  最大(255) <-> 关闭 之间切换
#   fanctl status  输出当前状态
#
# 驱动始终绑定: 所有档位都通过 hwmon pwm1 完成, 不做 bind/unbind.
if [ ! -e /sys/devices/platform/pwm-fan ]; then
	[ "$1" = "status" ] && echo "MODE=none"
	echo none
	exit 0
fi

CFG=/home/ark/.config/fan.cfg
FLAG=/home/ark/.config/.FAN_DISABLED

MODE=auto
PWM=0
# shellcheck source=/dev/null
[ -f "$CFG" ] && . "$CFG"
# 旧版智能档已移除: 遗留的 MODE=smart 按关闭处理
[ "$MODE" = "smart" ] && MODE=off

find_pwm() {
	local p
	for p in /sys/devices/platform/pwm-fan/hwmon/hwmon*/pwm1; do
		[ -e "$p" ] && { echo "$p"; return 0; }
	done
	return 1
}

set_pwm() {
	local p
	p=$(find_pwm) || return 1
	printf '%s' "$1" > "$p" 2>/dev/null
}

save() {
	mkdir -p "$(dirname "$CFG")"
	printf 'MODE=%s\nPWM=%s\n' "$MODE" "$PWM" > "$CFG"
	chown ark:ark "$CFG" 2>/dev/null
}

case "$1" in
	set)
		N="${2:-}"
		case "$N" in ''|*[!0-9]*) echo "usage: fanctl set <1-255>" >&2; exit 2 ;; esac
		if [ "$N" -lt 1 ] || [ "$N" -gt 255 ]; then
			echo "fanctl: speed must be 1-255" >&2
			exit 2
		fi
		MODE=manual; PWM="$N"; save
		rm -f "$FLAG"
		set_pwm "$N"
		;;
	on)
		MODE=auto; PWM=0; save
		rm -f "$FLAG"
		set_pwm 0
		;;
	off)
		MODE=off; PWM=0; save
		touch "$FLAG"
		set_pwm 0
		;;
	toggle)
		cur=0
		p=$(find_pwm) && cur=$(cat "$p" 2>/dev/null || echo 0)
		case "$cur" in ''|*[!0-9]*) cur=0 ;; esac
		if [ "$cur" -ge 250 ]; then
			MODE=off; PWM=0; save
			touch "$FLAG"
			set_pwm 0
		else
			MODE=manual; PWM=255; save
			rm -f "$FLAG"
			set_pwm 255
		fi
		;;
	apply)
		case "$MODE" in
			off)    touch "$FLAG"; set_pwm 0 ;;
			manual) rm -f "$FLAG"; set_pwm "$PWM" ;;
			*)      rm -f "$FLAG"; set_pwm 0 ;;
		esac
		;;
	status)
		printf 'MODE=%s PWM=%s pwm1=%s\n' "$MODE" "$PWM" \
			"$(cat "$(find_pwm)" 2>/dev/null || echo n/a)"
		;;
	*)
		echo "usage: fanctl {set N|on|off|toggle|apply|status}" >&2
		exit 2
		;;
esac
exit 0
