#!/bin/bash
# fanctl -- pwm-fan 转速控制 (0-255)
#   fanctl set N    手动转速, N = 1-255 (低 100 / 中 200 / 高 255)
#   fanctl off      关闭 (PWM 0 + .FAN_DISABLED 标记)
#   fanctl smart    智能温控 (内核 pwm-fan: 45/55/65C 升 低/中/高,
#                   40/50/60C 降档, 换档间隔 >=5s, 开机 5 分钟不启第一档)
#   fanctl apply    开机/ES 启动时应用 /home/ark/.config/fan.cfg
#   fanctl toggle   循环切换: 高(255) -> 智能 -> 关闭 -> 高
#   fanctl status   输出当前状态
#
# 驱动始终绑定: 所有档位都通过 hwmon pwm1 完成, 不做 bind/unbind.
# 智能策略在 pwm-fan 驱动内, 这里只切 hwmon smart 开关, 无常驻进程.
if [ ! -e /sys/devices/platform/pwm-fan ]; then
	[ "$1" = "status" ] && echo "MODE=none"
	echo none
	exit 0
fi

CFG=/home/ark/.config/fan.cfg
FLAG=/home/ark/.config/.FAN_DISABLED

MODE=auto
PWM=0
# shellcheck source=/dev/null
[ -f "$CFG" ] && . "$CFG"

find_pwm() {
	local p
	for p in /sys/devices/platform/pwm-fan/hwmon/hwmon*/pwm1; do
		[ -e "$p" ] && { echo "$p"; return 0; }
	done
	return 1
}

read_pwm() {
	local v
	v=$(cat "$(find_pwm)" 2>/dev/null) || v=0
	case "$v" in
	''|*[!0-9]*) v=0 ;;
	esac
	echo "$v"
}

set_pwm() {
	local p
	p=$(find_pwm) || return 1
	printf '%s' "$1" > "$p" 2>/dev/null
}

save() {
	mkdir -p "$(dirname "$CFG")"
	printf 'MODE=%s\nPWM=%s\n' "$MODE" "$PWM" > "$CFG"
	chown ark:ark "$CFG" 2>/dev/null
}

smart_attr() {
	local p
	p=$(find_pwm) || return 1
	echo "$(dirname "$p")/smart"
}

set_smart() {
	local a
	a=$(smart_attr) || return 1
	printf '%s' "$1" > "$a" 2>/dev/null
}

case "$1" in
	set)
		N="${2:-}"
		case "$N" in ''|*[!0-9]*) echo "usage: fanctl set <1-255>" >&2; exit 2 ;; esac
		if [ "$N" -lt 1 ] || [ "$N" -gt 255 ]; then
			echo "fanctl: speed must be 1-255" >&2
			exit 2
		fi
		set_smart 0
		MODE=manual; PWM="$N"; save
		rm -f "$FLAG"
		set_pwm "$N"
		;;
	on)
		set_smart 0
		MODE=auto; PWM=0; save
		rm -f "$FLAG"
		set_pwm 0
		;;
	off)
		set_smart 0
		MODE=off; PWM=0; save
		touch "$FLAG"
		set_pwm 0
		;;
	smart)
		MODE=smart
		PWM=$(read_pwm)
		save
		rm -f "$FLAG"
		if ! set_smart 1; then
			echo "fanctl: kernel smart mode unavailable" >&2
			exit 1
		fi
		;;
	toggle)
		if [ "$MODE" = "smart" ]; then
			# 智能 -> 关
			set_smart 0
			MODE=off; PWM=0; save
			touch "$FLAG"
			set_pwm 0
		elif [ "$MODE" = "manual" ] && [ "$PWM" -ge 250 ]; then
			# 高 -> 智能
			MODE=smart; PWM=$(read_pwm); save
			rm -f "$FLAG"
			if ! set_smart 1; then
				echo "fanctl: kernel smart mode unavailable" >&2
				exit 1
			fi
		else
			# 关/其他手动档 -> 高
			set_smart 0
			MODE=manual; PWM=255; save
			rm -f "$FLAG"
			set_pwm 255
		fi
		;;
	apply)
		case "$MODE" in
			smart)
				rm -f "$FLAG"
				set_smart 1 || echo "fanctl: kernel smart mode unavailable" >&2
				;;
			manual)
				set_smart 0
				rm -f "$FLAG"
				set_pwm "$PWM"
				;;
			off)
				set_smart 0
				touch "$FLAG"
				set_pwm 0
				;;
			*)
				set_smart 0
				rm -f "$FLAG"
				set_pwm 0
				;;
		esac
		;;
	status)
		printf 'MODE=%s PWM=%s pwm1=%s smart=%s\n' "$MODE" "$PWM" \
			"$(read_pwm)" \
			"$(cat "$(smart_attr)" 2>/dev/null || echo n/a)"
		;;
	*)
		echo "usage: fanctl {set N|on|off|smart|toggle|apply|status}" >&2
		exit 2
		;;
esac
exit 0
